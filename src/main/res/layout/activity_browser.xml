<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- حقل البحث في الصف العلوي مكان عنوان DownLS10 -->
    <LinearLayout
        android:id="@+id/addressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#121212"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp">

        <!-- صف علوي واحد: زر إعادة التحميل يسار حقل البحث -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <Button
            android:id="@+id/btnReload"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="إعادة تحميل الصفحة"
            android:text="⟳"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <EditText
            android:id="@+id/editUrl"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="#1E1E1E"
            android:hint="اكتب رابط أو ابحث..."
            android:textColorHint="#888888"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
        </LinearLayout>

        <!-- أزرار المتصفح في صف مستقل تحت شريط البحث -->
        <LinearLayout
            android:id="@+id/browserButtonsRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBrowserMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:text="☰"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnTabs"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_square_outline"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnForward"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnDownloads"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:text="⬇"
                android:textColor="#808080"
                android:textSize="21sp" />

            <Button
                android:id="@+id/btnBookmarkStar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:text="★"
                android:textColor="#808080"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_below="@id/addressBar"
        android:max="100" />

    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/progressBar" />

</RelativeLayout>
