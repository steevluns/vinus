<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- شريط البحث في المكان العلوي (محل DownLS10) -->
    <EditText
        android:id="@+id/editUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#1E1E1E"
        android:hint="اكتب رابط..."
        android:textColorHint="#888888"
        android:imeOptions="actionGo"
        android:inputType="textUri"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <!-- شريط الأزرار - محاذاة لليمين -->
    <LinearLayout
        android:id="@+id/addressBar"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_below="@id/editUrl"
        android:layout_alignParentEnd="true"
        android:background="#121212"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <Button
            android:id="@+id/btnTabs"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_square_outline"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnForward"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnDownloads"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="⬇"
            android:textColor="#808080"
            android:textSize="21sp" />

        <Button
            android:id="@+id/btnBookmarkStar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="★"
            android:textColor="#808080"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnReload"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_square_outline"
            android:text="↻"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnBrowserMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="☰"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_below="@id/addressBar"
        android:max="100" />

    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/progressBar" />

</RelativeLayout>
